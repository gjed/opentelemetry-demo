        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
          "editorMode": "code",          "expr": "100 * (sum(rate(demo_payment_transactions_total{error_type!=\"\"}[1m])) or on() vector(0)) / sum(rate(demo_payment_transactions_total[1m]))",          "interval": "5s",
          "legendFormat": "error rate",
          "range": true,
          "refId": "A"
        }
