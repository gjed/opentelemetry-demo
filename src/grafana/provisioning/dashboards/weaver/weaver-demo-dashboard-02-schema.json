        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
          "editorMode": "code",          "expr": "sum by (demo_payment_currency) (rate(demo_payment_transactions_total[30s])) or on() vector(0)",          "interval": "5s",
          "legendFormat": "{{demo_payment_currency}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Payment transaction counter",
      "description": "Rate of `demo.payment.transactions` (payment service), split by demo.payment.currency. Prometheus series: `demo_payment_transactions_total` with labels demo_payment_currency. A flat zero line means no sample with this name arrived in the last 30s. Linked alerts: see the Schema alerts list.",
      "type": "timeseries"
    }    ,{
      "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": { "mode": "line" }          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 2 }            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 9, "x": 9, "y": 3 },      "id": 4,      "options": {
