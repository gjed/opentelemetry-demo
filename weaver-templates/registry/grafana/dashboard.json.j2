{#
  Copyright The OpenTelemetry Authors
  SPDX-License-Identifier: Apache-2.0

  Grafana dashboard generated from the OpenTelemetry Demo telemetry schema.
  One timeseries panel per metric of the selected services, grouped by the
  metric's attributes, plus the list of the alert rules generated from the
  same registry (alerting.yml.j2), each linked to its panel.
  A metric with an error attribute (annotation `error_attribute`) gets a second
  panel right after its rate panel: the share of samples carrying that
  attribute. The error attribute is left out of the rate panel's split.

  Prometheus naming (OTLP receiver): dots become underscores, the unit is
  appended for base units (s -> _seconds, By -> _bytes), counters get _total,
  histograms are queried through _bucket.

  Parameters (weaver registry generate -D key=value):
    variant:  "schema" (default): generated from telemetry-schema/, the
              contract. "baseline": generated from a copy of the registry with
              the legacy names applied (make demo-generate-baseline), i.e. the
              dashboard the team wrote.
    services: comma separated list of the services to include
              (metric annotation `service`). Default: payment,cart,currency.
#}
{%- set variant = params.variant | default("schema", true) -%}
{%- set services = (params.services | default("payment,cart,currency", true)) | split(",") -%}
{%- if variant == "baseline" -%}
{%- set title = "01 - Baseline: the dashboard the team wrote" -%}
{%- set uid = "weaver-01-baseline" -%}
{%- set header = "### What the team sees today\\n\\nPanels and alerts written by hand, on the label names the team knew when they built them. The payment rate is fine and every alert is green. The error-rate panel reads the **legacy label** (`paymentError`): since the service moved to the schema name, this panel can no longer see a single failure." -%}
{%- else -%}
{%- set title = "02 - Generated from the telemetry schema" -%}
{%- set uid = "weaver-02-schema" -%}
{%- set header = "### What the contract says\\n\\nSame panels and alerts, generated by `weaver registry generate` from `telemetry-schema/`. The queries use the names **declared in the schema** (`error.type`), which is what the service emits. The error-rate panel shows the real share of failed payments, and the alert on it pages." -%}
{%- endif %}
{#- Layout: header full width; metric panels two per row in the left 18
    columns; the alert list in a narrow column on the right, as tall as the
    metric grid. Panel ids: 1 header, 2 alert list, then one per panel in
    registry order: a metric with an error attribute gets its error-rate panel
    right after its rate panel (alerting.yml.j2 relies on this). -#}
{%- set ns = namespace(panel_id=1, y_pos=3, col=0, panels=0) -%}
{%- for root_ns in ctx %}{%- for metric in root_ns.metrics %}
{%- if metric.annotations is defined and metric.annotations.service is defined and metric.annotations.service in services %}{%- set ns.panels = ns.panels + (2 if metric.annotations.error_attribute is defined else 1) %}{%- endif %}
{%- endfor %}{%- endfor -%}
{%- set rows = (ns.panels + 1) // 2 -%}
{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": {{ ns.panel_id }},
      {%- set ns.panel_id = ns.panel_id + 1 %}
      "options": {
        "content": "{{ header }}",
        "mode": "markdown"
      },
      "title": "{{ title }}",
      "type": "text"
    },
    {
      "gridPos": { "h": {{ rows * 8 }}, "w": 6, "x": 18, "y": 3 },
      "id": {{ ns.panel_id }},
      {%- set ns.panel_id = ns.panel_id + 1 %}
      "options": {
        "alertName": "",
        "dashboardAlerts": true,
        "groupBy": [],
        "groupMode": "default",
        "maxItems": 20,
        "showInactiveAlerts": true,
        "sortOrder": 1,
        "stateFilter": {
          "error": true,
          "firing": true,
          "noData": true,
          "normal": true,
          "pending": true,
          "recovering": true
        },
        "viewMode": "list"
      },
      "title": "Schema alerts",
      "description": "Alert rules generated from the same telemetry schema as the panels. Each rule is linked to the panel of its metric.",
      "type": "alertlist"
    }
    {%- for svc in services %}
    {%- for root_ns in ctx %}
    {%- for metric in root_ns.metrics %}
    {%- if metric.annotations is defined and metric.annotations.service is defined and metric.annotations.service == svc %}
    {%- set base = metric.metric_name | replace(".", "_") %}
    {%- if metric.unit == "s" %}{%- set base = base + "_seconds" %}
    {%- elif metric.unit == "By" %}{%- set base = base + "_bytes" %}
    {%- endif %}
    {#- err: error attribute (annotation). Its label is left out of the split and
        gets an error-rate panel of its own. -#}
    {%- set err = metric.annotations.error_attribute | default("", true) %}
    {%- set errexpr = "100 * (sum(rate(" ~ base ~ "_total{" ~ (err | replace(".", "_")) ~ "!=\\\"\\\"}[1m])) or on() vector(0)) / sum(rate(" ~ base ~ "_total[1m]))" %}
    {%- set split = metric.attributes | default([]) | rejectattr("name", "equalto", err) | list %}
    {%- set labels = split | map(attribute="name") | map("replace", ".", "_") | list %}
    {%- set by = labels | join(", ") %}
    {%- set legend = "" %}
    {%- if labels %}{%- set legend = "{{" ~ (labels | join("}} {{")) ~ "}}" %}{%- endif %}
    {%- set brief = metric.brief | default(metric.metric_name, true) %}
    {%- for kind in (["rate", "error"] if err else ["rate"]) %}
    ,{
      "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false{% if kind == "error" %},
            "thresholdsStyle": { "mode": "line" }{% endif %}
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }{% if kind == "error" %},
              { "color": "red", "value": {{ metric.annotations.alert_max_error_pct }} }{% endif %}
            ]
          },
          "unit": "{{ 'percent' if kind == "error" else (metric.unit | default('short', true)) }}"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 9, "x": {{ ns.col * 9 }}, "y": {{ ns.y_pos }} },
      {%- if ns.col == 1 %}
      {%- set ns.y_pos = ns.y_pos + 8 %}
      {%- endif %}
      {%- set ns.col = (ns.col + 1) % 2 %}
      "id": {{ ns.panel_id }},
      {%- set ns.panel_id = ns.panel_id + 1 %}
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
          "editorMode": "code",
          {%- if kind == "error" %}
          "expr": "{{ errexpr }}",
          {%- elif metric.instrument == "counter" %}
          "expr": "sum by ({{ by }}) (rate({{ base }}_total[30s])) or on() vector(0)",
          {%- elif metric.instrument == "histogram" %}
          "expr": "histogram_quantile(0.95, sum by (le{% if by %}, {{ by }}{% endif %}) (rate({{ base }}_bucket[30s]))) or on() vector(0)",
          {%- else %}
          "expr": "sum by ({{ by }}) ({{ base }})",
          {%- endif %}
          "interval": "5s",
          "legendFormat": "{{ 'error rate' if kind == "error" else (legend | trim if legend else metric.metric_name) }}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "{{ brief ~ ': error rate' if kind == "error" else brief }}",
      "description": "{% if kind == "error" %}Share of `{{ metric.metric_name }}` samples carrying `{{ err }}` in the last minute ({{ metric.annotations.service }} service). 0 means no sample carried the attribute: either no errors, or the attribute is recorded under another name.{% else %}{% if metric.instrument == "histogram" %}p95 of {% else %}Rate of {% endif %}`{{ metric.metric_name }}` ({{ metric.annotations.service }} service){% if split %}, split by {{ split | map(attribute="name") | join(", ") }}{% endif %}. Prometheus series: `{{ base }}{% if metric.instrument == "counter" %}_total{% elif metric.instrument == "histogram" %}_bucket{% endif %}`{% if labels %} with labels {{ by }}{% endif %}. A flat zero line means no sample with this name arrived in the last 30s. Linked alerts: see the Schema alerts list.{% endif %}",
      "type": "timeseries"
    }
    {%- endfor %}
    {%- endif %}
    {%- endfor %}
    {%- endfor %}
    {%- endfor %}
  ],
  "preload": false,
  "refresh": "5s",
  "schemaVersion": 40,
  "tags": ["weaver", "demo", "generated"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "{{ title }}",
  "uid": "{{ uid }}",
  "version": 1
}
