  Copyright The OpenTelemetry Authors
  SPDX-License-Identifier: Apache-2.0

  Grafana dashboard generated from the OpenTelemetry Demo telemetry schema.
  One timeseries panel per metric of the selected services, grouped by the
  metric's attributes, plus the list of the alert rules generated from the
  same registry (alerting.yml.j2), each linked to its panel.

  Prometheus naming (OTLP receiver): dots become underscores, the unit is
  appended for base units (s -> _seconds, By -> _bytes), counters get _total,
  histograms are queried through _bucket.

  Parameters (weaver registry generate -D key=value):
    variant:  "schema" (default): generated from telemetry-schema/, the
              contract. "baseline": generated from the registry with the
              FIX(drift) names applied, i.e. what the code emits today.
    services: comma separated list of the services to include
              (metric annotation `service`). Default: payment,cart,currency.
#}
{%- set variant = params.variant | default("schema", true) -%}
{%- set services = (params.services | default("payment,cart,currency", true)) | split(",") -%}
{%- if variant == "baseline" -%}
{%- set title = "01 - Baseline: the dashboard the team wrote" -%}
{%- set uid = "weaver-01-baseline" -%}
{%- set header = "### What the team sees today\\n\\nPanels and alerts written against the metric and attribute names the services **currently emit**. Everything is green: nothing here says the names drifted from the telemetry schema." -%}
{%- else -%}
{%- set title = "02 - Generated from the telemetry schema" -%}
{%- set uid = "weaver-02-schema" -%}
{%- set header = "### What the contract says\\n\\nSame panels and alerts, generated by `weaver registry generate` from `telemetry-schema/`. The queries use the names **declared in the schema**. A flat zero line and a red alert mean the service emits something else: the instrumentation drifted from the contract." -%}
{%- endif -%}
{#- Layout: header full width; metric panels two per row in the left 18
    columns; the alert list in a narrow column on the right, as tall as the
    metric grid. Panel ids: 1 header, 2 alert list, then one per metric in
    registry order (alerting.yml.j2 relies on this). -#}
{%- set ns = namespace(panel_id=1, y_pos=3, col=0, metrics=0) -%}
{%- for root_ns in ctx %}{%- for metric in root_ns.metrics %}
{%- if metric.annotations is defined and metric.annotations.service is defined and metric.annotations.service in services %}{%- set ns.metrics = ns.metrics + 1 %}{%- endif %}
{%- endfor %}{%- endfor -%}
{%- set rows = (ns.metrics + 1) // 2 -%}
{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": {{ ns.panel_id }},
      {%- set ns.panel_id = ns.panel_id + 1 %}
      "options": {
        "content": "{{ header }}",
        "mode": "markdown"
      },
      "title": "{{ title }}",
      "type": "text"
    },
    {
      "gridPos": { "h": {{ rows * 8 }}, "w": 6, "x": 18, "y": 3 },
      "id": {{ ns.panel_id }},
      {%- set ns.panel_id = ns.panel_id + 1 %}
      "options": {
        "alertName": "",
        "dashboardAlerts": true,
        "groupBy": [],
        "groupMode": "default",
        "maxItems": 20,
        "showInactiveAlerts": true,
        "sortOrder": 1,
        "stateFilter": {
          "error": true,
          "firing": true,
          "noData": true,
          "normal": true,
          "pending": true,
          "recovering": true
        },
        "viewMode": "list"
      },
      "title": "Schema alerts",
      "description": "Alert rules generated from the same telemetry schema as the panels. Each rule is linked to the panel of its metric.",
      "type": "alertlist"
    }
    {%- for svc in services %}
    {%- for root_ns in ctx %}
    {%- for metric in root_ns.metrics %}
    {%- if metric.annotations is defined and metric.annotations.service is defined and metric.annotations.service == svc %}
    {%- set base = metric.metric_name | replace(".", "_") %}
    {%- if metric.unit == "s" %}{%- set base = base + "_seconds" %}
    {%- elif metric.unit == "By" %}{%- set base = base + "_bytes" %}
    {%- endif %}
    {%- set labels = metric.attributes | default([]) | map(attribute="name") | map("replace", ".", "_") | list %}
    {%- set by = labels | join(", ") %}
    {%- set legend = "" %}
    {%- if labels %}{%- set legend = "{{" ~ (labels | join("}} {{")) ~ "}}" %}{%- endif %}
    ,{
      "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "{{ metric.unit | default('short', true) }}"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 9, "x": {{ ns.col * 9 }}, "y": {{ ns.y_pos }} },
      {%- if ns.col == 1 %}
      {%- set ns.y_pos = ns.y_pos + 8 %}
      {%- endif %}
      {%- set ns.col = (ns.col + 1) % 2 %}
      "id": {{ ns.panel_id }},
      {%- set ns.panel_id = ns.panel_id + 1 %}
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
          "editorMode": "code",
          {%- if metric.instrument == "counter" %}
          "expr": "sum by ({{ by }}) (rate({{ base }}_total[30s])) or on() vector(0)",
          {%- elif metric.instrument == "histogram" %}
          "expr": "histogram_quantile(0.95, sum by (le{% if by %}, {{ by }}{% endif %}) (rate({{ base }}_bucket[30s]))) or on() vector(0)",
          {%- else %}
          "expr": "sum by ({{ by }}) ({{ base }})",
          {%- endif %}
          "interval": "5s",
          "legendFormat": "{{ legend | trim if legend else metric.metric_name }}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "{{ metric.brief | default(metric.metric_name, true) }}",
      "description": "{% if metric.instrument == "histogram" %}p95 of {% else %}Rate of {% endif %}`{{ metric.metric_name }}` ({{ metric.annotations.service }} service){% if labels %}, split by {{ metric.attributes | map(attribute="name") | join(", ") }}{% endif %}. Prometheus series: `{{ base }}{% if metric.instrument == "counter" %}_total{% elif metric.instrument == "histogram" %}_bucket{% endif %}`{% if labels %} with labels {{ by }}{% endif %}. A flat zero line means no sample with this name arrived in the last 30s. Linked alerts: see the Schema alerts list.",
      "type": "timeseries"
    }
    {%- endif %}
    {%- endfor %}
    {%- endfor %}
    {%- endfor %}
  ],
  "preload": false,
  "refresh": "5s",
  "schemaVersion": 40,
  "tags": ["weaver", "demo", "generated"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "{{ title }}",
  "uid": "{{ uid }}",
  "version": 1
}
