{#
  Copyright The OpenTelemetry Authors
  SPDX-License-Identifier: Apache-2.0

  Comparison alert rules: Original (hardcoded) vs Weaver (semconv-resolved).

  Demonstrates the semconv metric name fragmentation problem by creating
  two sets of RPC server liveness alerts — one using the old metric name
  (rpc_server_duration_milliseconds) and one using the new semconv name
  resolved from the registry (rpc.server.call.duration).

  Result at runtime:
    - "ad" (Java Agent, old semconv) → Original fires, Weaver = NoData
    - "checkout" / "product-catalog" (Go otelgrpc, new semconv) → Weaver fires, Original = NoData

  This is the silent alert failure that schema-driven observability prevents.
#}
{%- set ns = namespace(rpc_server_prom="rpc_server_call_duration") -%}
{%- for root_ns in ctx -%}
  {%- for metric in root_ns.metrics -%}
    {%- if metric.metric_name == "rpc.server.call.duration" -%}
      {%- set ns.rpc_server_prom = metric.metric_name | replace(".", "_") -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
---
# Generated by Weaver — do not edit manually.
# Template: comparison-alerting.yml.j2
#
# Old-semconv metric: rpc_server_duration_milliseconds (hardcoded)
# New-semconv metric: {{ ns.rpc_server_prom }}_seconds (resolved from registry)

apiVersion: 1
groups:
  # ── Original alerts: hardcoded old RPC semconv metric name ──────────
  - orgId: 1
    name: ComparisonOriginal.1m
    folder: Weaver - Observability by Design
    interval: 1m
    rules:
      # ad (Java Agent) — emits old metric → FIRES
      - uid: comparison-original-rpc-ad
        title: "Original: RPC Server Liveness — ad"
        condition: threshold
        data:
          - refId: metric_rate
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: webstore-metrics
            model:
              editorMode: code
              expr: "sum(rate(rpc_server_duration_milliseconds_count{service_name=\"ad\", service_namespace=\"opentelemetry-demo\"}[5m]))"
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: metric_rate
          - refId: threshold
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - 0
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - threshold
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: metric_rate
              intervalMs: 1000
              maxDataPoints: 43200
              refId: threshold
              type: threshold
        noDataState: NoData
        execErrState: Error
        for: 2m
        keepFiringFor: 2m
        annotations:
          summary: "Old-semconv RPC liveness for ad"
          description: >-
            Checks rpc_server_duration_milliseconds (old semconv) for the ad
            service. This alert FIRES because the Java Agent emits the old
            metric name.
        labels:
          service_name: "ad"
          service_namespace: opentelemetry-demo
          severity: warning
          source: original-hardcoded
          semconv_version: old
        isPaused: false
        notification_settings:
          receiver: grafana-default-email

