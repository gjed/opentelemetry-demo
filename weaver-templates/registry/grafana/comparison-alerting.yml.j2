              type: threshold
        noDataState: NoData
        execErrState: Error
        for: 2m
        keepFiringFor: 2m
        annotations:
          summary: "Old-semconv RPC liveness for checkout"
          description: >-
            Checks rpc_server_duration_milliseconds (old semconv) for checkout.
            This alert is SILENT (NoData) because checkout uses Go otelgrpc
            which emits {{ ns.rpc_server_prom }}_seconds (new semconv) instead.
