{#
  Copyright The OpenTelemetry Authors
  SPDX-License-Identifier: Apache-2.0

  Grafana alerting rules generated from the OpenTelemetry Demo telemetry schema.
  One rule per counter metric: it fires when the metric stops being emitted.

  Tuned for a live demo: services export every 5s, the group evaluates every
  10s, the rule looks back 15s and has no pending period, so a renamed metric
  (telemetry drift) turns the alert red within ~15-25s of the deploy.
#}
---
apiVersion: 1
groups:
  - orgId: 1
    name: WeaverDemo.10s
    folder: Weaver - Observability by Design
    interval: 10s
    rules:
{% for root_ns in ctx %}
{% for metric in root_ns.metrics %}
{% if metric.instrument == "counter" %}
{% set prom_name = metric.metric_name | replace(".", "_") + "_total" %}
{% set service_name = "" %}
{% if metric.annotations is defined and metric.annotations.service is defined %}
{% set service_name = metric.annotations.service %}
{% endif %}
      - uid: weaver-{{ metric.metric_name | replace(".", "-") }}
        title: "Weaver: {{ metric.metric_name }} stopped being emitted"
        condition: threshold
        data:
          - refId: absent
            relativeTimeRange:
              from: 60
              to: 0
            datasourceUid: webstore-metrics
            model:
              editorMode: code
              expr: "absent_over_time({{ prom_name }}[15s])"
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: absent
          - refId: threshold
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - 0
                    type: gt
              datasource:
                type: __expr__
                uid: __expr__
              expression: absent
              intervalMs: 1000
              maxDataPoints: 43200
              refId: threshold
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 0s
        annotations:
          summary: "Schema metric {{ metric.metric_name }} is no longer emitted"
          description: >-
            No sample of {{ metric.metric_name }} ({{ prom_name }}) was received
            in the last 15s. The metric was renamed or dropped: instrumentation
            drifted from the telemetry schema.
        labels:
{% if service_name %}
          service_name: "{{ service_name }}"
{% endif %}
          service_namespace: opentelemetry-demo
          severity: critical
          source: weaver-codegen
        isPaused: false
        notification_settings:
          receiver: grafana-default-email
{% endif %}
{% endfor %}
{% endfor %}
