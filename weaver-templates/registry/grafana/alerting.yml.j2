{#
  Copyright The OpenTelemetry Authors
  SPDX-License-Identifier: Apache-2.0

  Grafana alerting rules generated from the OpenTelemetry Demo telemetry schema.
  The rules are the operational alerts a team would write by hand; the
  thresholds come from the metric annotations in the registry:

    alert_min_per_min   counter:   fire when fewer than N events per minute
    error_attribute     counter:   with alert_max_error_pct N: fire when more
                                   than N percent of the events carry the
                                   error attribute in the last minute
    alert_max_p95_ms    histogram: fire when the p95 is above N milliseconds

  Absent series count as zero (`or on() vector(0)`): a counter nobody emits
  any more fires the "below N per minute" rule exactly like a real outage.

  Every rule is linked to the panel of its metric on the dashboard generated
  from the same registry (__dashboardUid__ / __panelId__). Rule titles use the
  metric brief, not the metric name, so the baseline and the schema variants
  show the same titles while querying different series.

  Tuned for a live demo: services export every 5s and the group evaluates
  every 10s with no pending period.

  Parameters (weaver registry generate -D key=value): same as dashboard.json.j2.
    variant:  "schema" (default) or "baseline". Selects the dashboard the
              rules link to, the rule uid prefix and the folder.
    services: comma separated list of services to include.
#}
{%- set variant = params.variant | default("schema", true) -%}
{%- set services = (params.services | default("payment,cart,currency", true)) | split(",") -%}
{%- if variant == "baseline" -%}
{%- set num = "01" %}{%- set dash_uid = "weaver-01-baseline" %}{%- set folder = "Weaver 01 - Baseline" -%}
{%- else -%}
{%- set num = "02" %}{%- set dash_uid = "weaver-02-schema" %}{%- set folder = "Weaver 02 - Generated from schema" -%}
{%- endif -%}
{#- Panel ids follow the dashboard template: 1 header, 2 alert list, then one
    per panel in registry order (a metric with an error attribute has two:
    its rate panel, then its error-rate panel). -#}
{%- set ns = namespace(panel_id=3) -%}
{%- macro rule(uid, title, panel_id, expr, op, threshold, severity, service_name, summary, description) %}

      - uid: {{ uid }}
        title: "{{ title }}"
        condition: threshold
        data:
          - refId: value
            relativeTimeRange:
              from: 120
              to: 0
            datasourceUid: webstore-metrics
            model:
              editorMode: code
              expr: "{{ expr }}"
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: value
          - refId: threshold
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ threshold }}
                    type: {{ op }}
              datasource:
                type: __expr__
                uid: __expr__
              expression: value
              intervalMs: 1000
              maxDataPoints: 43200
              refId: threshold
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 0s
        annotations:
          __dashboardUid__: {{ dash_uid }}
          __panelId__: "{{ panel_id }}"
          summary: "{{ summary }}"
          description: "{{ description }}"
        labels:
          service_name: "{{ service_name }}"
          service_namespace: opentelemetry-demo
          severity: {{ severity }}
          source: weaver-codegen
        isPaused: false
        notification_settings:
          receiver: grafana-default-email
{%- endmacro %}
---
apiVersion: 1
# Rule UIDs provisioned by earlier versions of this template. Grafana file
# provisioning never removes a rule on its own; listing them here keeps a
# persistent Grafana from showing them next to the current rules.
deleteRules:
{% for legacy in ["payment-transactions", "payment-transactions-currency", "payment-transactions-currencyCode", "payment-transactions-mix", "cart-add-item-latency", "cart-get-cart-latency", "exchange-conversions", "exchange-conversions-to"] %}
  - orgId: 1
    uid: w{{ num }}-{{ legacy }}
{% endfor -%}
groups:
  - orgId: 1
    name: Weaver{{ num }}.10s
    folder: {{ folder }}
    interval: 10s
    rules:
{%- for svc in services %}
{%- for root_ns in ctx %}
{%- for metric in root_ns.metrics %}
{%- if metric.annotations is defined and metric.annotations.service is defined and metric.annotations.service == svc %}
{%- set panel_id = ns.panel_id %}
{%- set ann = metric.annotations %}
{%- set ns.panel_id = ns.panel_id + (2 if ann.error_attribute is defined else 1) %}
{%- set base = metric.metric_name | replace(".", "_") %}
{%- if metric.unit == "s" %}{%- set base = base + "_seconds" %}{%- elif metric.unit == "By" %}{%- set base = base + "_bytes" %}{%- endif %}
{%- set brief = metric.brief | default(metric.metric_name, true) %}
{#- uid: metric name without its first namespace segment (demo./app.) #}
{%- set short = metric.metric_name | regex_replace("^[^.]+\\.", "") | replace(".", "-") | replace("_", "-") %}
{%- set service_name = ann.service %}
{%- set err = ann.error_attribute | default("", true) %}
{%- set errexpr = "100 * (sum(rate(" ~ base ~ "_total{" ~ (err | replace(".", "_")) ~ "!=\\\"\\\"}[1m])) or on() vector(0)) / sum(rate(" ~ base ~ "_total[1m]))" %}
{%- if metric.instrument == "counter" and ann.alert_min_per_min is defined %}
{{ rule("w" ~ num ~ "-" ~ short ~ "-rate",
        brief ~ ": under " ~ ann.alert_min_per_min ~ " per minute",
        panel_id,
        "sum(rate(" ~ base ~ "_total[1m])) * 60 or on() vector(0)",
        "lt", ann.alert_min_per_min, "critical", service_name,
        brief ~ " dropped under " ~ ann.alert_min_per_min ~ " per minute",
        "Fewer than " ~ ann.alert_min_per_min ~ " " ~ metric.metric_name ~ " events per minute in the last minute (" ~ service_name ~ " service). Check the " ~ service_name ~ " service and the services calling it.") }}
{%- endif %}
{%- if metric.instrument == "counter" and ann.error_attribute is defined and ann.alert_max_error_pct is defined %}
{{ rule("w" ~ num ~ "-" ~ short ~ "-errors",
        brief ~ ": error rate over " ~ ann.alert_max_error_pct ~ "%",
        panel_id + 1,
        errexpr,
        "gt", ann.alert_max_error_pct, "critical", service_name,
        brief ~ " error rate above " ~ ann.alert_max_error_pct ~ "%",
        "More than " ~ ann.alert_max_error_pct ~ "% of " ~ metric.metric_name ~ " samples carried " ~ err ~ " over the last minute (" ~ service_name ~ " service).") }}
{%- endif %}
{%- if metric.instrument == "histogram" and ann.alert_max_p95_ms is defined %}
{{ rule("w" ~ num ~ "-" ~ short ~ "-p95",
        brief ~ ": p95 over " ~ ann.alert_max_p95_ms ~ " ms",
        panel_id,
        "histogram_quantile(0.95, sum by (le) (rate(" ~ base ~ "_bucket[1m]))) * 1000 or on() vector(0)",
        "gt", ann.alert_max_p95_ms, "warning", service_name,
        brief ~ " p95 above " ~ ann.alert_max_p95_ms ~ " ms",
        "The 95th percentile of " ~ metric.metric_name ~ " was above " ~ ann.alert_max_p95_ms ~ " ms over the last minute (" ~ service_name ~ " service).") }}
{%- endif %}
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- endfor %}
{{ "\n" }}
