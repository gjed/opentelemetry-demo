{#
  Copyright The OpenTelemetry Authors
  SPDX-License-Identifier: Apache-2.0

  Grafana alerting rules generated from the OpenTelemetry Demo telemetry schema.
  Per counter metric:
    - a liveness rule: fires when the metric stops being emitted
    - one rule per required attribute: fires when the metric is emitted
      without that attribute (renamed or dropped label)
  Every rule is linked to the panel of its metric on the dashboard generated
  from the same registry (__dashboardUid__ / __panelId__), so the panel shows
  the alert state and the dashboard's alert list shows only these rules.

  Tuned for a live demo: services export every 5s, the group evaluates every
  10s, the rule looks back 15s and has no pending period, so a renamed metric
  (telemetry drift) turns the alert red within ~15-25s of the deploy.

  Rule titles use the metric brief, not the metric name, so the baseline and
  the schema variants show the same titles while querying different series.

  Parameters (weaver registry generate -D key=value): same as dashboard.json.j2.
    variant:  "schema" (default) or "baseline". Selects the dashboard the
              rules link to, the rule uid prefix and the folder.
    services: comma separated list of services to include.
#}
{%- set variant = params.variant | default("schema", true) -%}
{%- set services = (params.services | default("payment,cart,currency", true)) | split(",") -%}
{%- if variant == "baseline" -%}
{%- set num = "01" %}{%- set dash_uid = "weaver-01-baseline" %}{%- set folder = "Weaver 01 - Baseline" -%}
{%- else -%}
{%- set num = "02" %}{%- set dash_uid = "weaver-02-schema" %}{%- set folder = "Weaver 02 - Generated from schema" -%}
{%- endif -%}
{#- Panel ids follow the dashboard template: 1 header, 2 alert list, then one
    per included metric in registry order. -#}
{%- set ns = namespace(panel_id=3) -%}
---
apiVersion: 1
groups:
  - orgId: 1
    name: Weaver{{ num }}.10s
    folder: {{ folder }}
    interval: 10s
    rules:
{% for svc in services %}
{% for root_ns in ctx %}
{% for metric in root_ns.metrics %}
{% if metric.annotations is defined and metric.annotations.service is defined and metric.annotations.service == svc %}
{% set panel_id = ns.panel_id %}
{% set ns.panel_id = ns.panel_id + 1 %}
{% if metric.instrument == "counter" or metric.instrument == "histogram" %}
{% set base = metric.metric_name | replace(".", "_") %}
{% if metric.unit == "s" %}{% set base = base + "_seconds" %}{% elif metric.unit == "By" %}{% set base = base + "_bytes" %}{% endif %}
{% if metric.instrument == "counter" %}{% set prom_name = base + "_total" %}{% else %}{% set prom_name = base + "_count" %}{% endif %}
{% set label_title = metric.brief | default(metric.metric_name, true) %}
{# uid: metric name without its first namespace segment (demo./app.) #}
{% set short = metric.metric_name | regex_replace("^[^.]+\\.", "") | replace(".", "-") | replace("_", "-") %}
{% set service_name = "" %}
{% if metric.annotations is defined and metric.annotations.service is defined %}
{% set service_name = metric.annotations.service %}
{% endif %}
      - uid: w{{ num }}-{{ short }}
        title: "{{ label_title }}: stopped being emitted"
        condition: threshold
        data:
          - refId: absent
            relativeTimeRange:
              from: 60
              to: 0
            datasourceUid: webstore-metrics
            model:
              editorMode: code
              expr: "absent_over_time({{ prom_name }}[15s])"
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: absent
          - refId: threshold
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - 0
                    type: gt
              datasource:
                type: __expr__
                uid: __expr__
              expression: absent
              intervalMs: 1000
              maxDataPoints: 43200
              refId: threshold
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 0s
        annotations:
          __dashboardUid__: {{ dash_uid }}
          __panelId__: "{{ panel_id }}"
          summary: "Schema metric {{ metric.metric_name }} is no longer emitted"
          description: >-
            No sample of {{ metric.metric_name }} ({{ prom_name }}) was received
            in the last 15s. The metric was renamed or dropped: instrumentation
            drifted from the telemetry schema.
        labels:
{% if service_name %}
          service_name: "{{ service_name }}"
{% endif %}
          service_namespace: opentelemetry-demo
          severity: critical
          source: weaver-codegen
        isPaused: false
        notification_settings:
          receiver: grafana-default-email
{% for attr in metric.attributes | default([]) %}
{% if attr.requirement_level is defined and attr.requirement_level == "required" %}
{% set label = attr.name | replace(".", "_") %}
{% set attr_short = (attr.name | split(".") | last) | replace("_", "-") %}
      - uid: w{{ num }}-{{ short }}-{{ attr_short }}
        title: "{{ label_title }}: missing required attribute ({{ attr.brief | default(attr.name, true) | lower }})"
        condition: threshold
        data:
          - refId: absent
            relativeTimeRange:
              from: 60
              to: 0
            datasourceUid: webstore-metrics
            model:
              editorMode: code
              expr: "absent_over_time({{ prom_name }}{{ '{' }}{{ label }}=~\".+\"{{ '}' }}[15s])"
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: absent
          - refId: threshold
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - 0
                    type: gt
              datasource:
                type: __expr__
                uid: __expr__
              expression: absent
              intervalMs: 1000
              maxDataPoints: 43200
              refId: threshold
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 0s
        annotations:
          __dashboardUid__: {{ dash_uid }}
          __panelId__: "{{ panel_id }}"
          summary: "Required attribute {{ attr.name }} missing on {{ metric.metric_name }}"
          description: >-
            No sample of {{ metric.metric_name }} carried the required attribute
            {{ attr.name }} ({{ label }}) in the last 15s. The attribute was
            renamed or dropped: instrumentation drifted from the telemetry schema.
        labels:
{% if service_name %}
          service_name: "{{ service_name }}"
{% endif %}
          service_namespace: opentelemetry-demo
          severity: warning
          source: weaver-codegen
        isPaused: false
        notification_settings:
          receiver: grafana-default-email
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}
